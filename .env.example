# App
NODE_ENV=local
PORT=3000
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
# Swagger UI(/docs) 노출 여부 (운영 환경에서는 false)
SWAGGER_ENABLED=true

# PostgreSQL (docker-compose와 공유)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=tagin
DB_PASSWORD=tagin
DB_DATABASE=tagin

# Redis (docker-compose와 공유)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=tagin

# JWT (32자 이상, 운영 환경에서는 반드시 교체)
JWT_ACCESS_SECRET=change-me-to-a-long-random-secret-value
# Access Token 만료 시간 (초)
JWT_ACCESS_EXPIRES_IN=900
# Refresh Token 만료 시간 (초, 기본 14일). Redis에 해시로 저장되며 재발급 시마다 교체된다.
JWT_REFRESH_EXPIRES_IN=1209600

# TEMP(test): Authorization 헤더 없이 온 요청에 사용할 사용자 id. 비우면 기본 테스트 사용자(고정 UUID)를
# 기동 시 자동 생성해 사용한다. NODE_ENV=production에서는 무시된다. 배포 전 제거 (#18)
TEST_USER_ID=

# Google OAuth Client ID (ID Token의 audience 검증용, Google Cloud Console > 사용자 인증 정보)
# 웹(React)
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_SECRET=your-web-client-secret
# iOS(Expo) - 번들 ID: com.tagin.app (미사용 시 비워둠)
GOOGLE_IOS_CLIENT_ID=
# Android(Expo) - 패키지명: com.tagin.app + 서명 키 SHA-1 등록 필요 (미사용 시 비워둠)
GOOGLE_ANDROID_CLIENT_ID=

# 오브젝트 스토리지 (S3 / 로컬 MinIO). 드라이브 파일 업로드에 사용
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
# MinIO 사용 시 http://localhost:9000, AWS S3는 비워둠
AWS_S3_ENDPOINT=http://localhost:9000
AWS_S3_BUCKET_NAME=tagin
# presigned URL을 클라이언트가 직접 여는 주소. 서버가 보는 주소와 다를 때만 설정 (비우면 AWS_S3_ENDPOINT)
AWS_S3_PUBLIC_ENDPOINT=

# 임베딩 API (OpenAI 호환, 기본 OpenRouter). 업로드 파일의 폴더 자동 분류(벡터 검색)에 사용
# OpenRouter 키(sk-or-...)를 넣는다. OpenAI를 직접 쓰려면 BASE_URL=https://api.openai.com/v1, MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
# OpenRouter 모델 ID는 제공자 접두사가 붙는다. 모델을 다른 계열로 바꾸면 기존 벡터와 호환되지 않아 재색인이 필요하다
EMBEDDING_MODEL=openai/text-embedding-3-small
# drive_folders/drive_items의 vector 차원과 같아야 한다 (변경 시 마이그레이션 필요)
EMBEDDING_DIMENSIONS=1536
# TEMP(test): 기동 시 test/fixtures/dummy-files를 테스트 사용자 드라이브에 업로드 (이미 올린 파일은 건너뜀).
# EMBEDDING_API_KEY와 스토리지(MinIO)가 필요하다. NODE_ENV=production에서는 무시된다. 배포 전 제거
SEED_DUMMY_DRIVE=true
# 기존 폴더로 인정할 최소 코사인 유사도 (0~1)
DRIVE_SIMILARITY_THRESHOLD=0.55

# 휴지통 보관 일수 (경과 후 매일 03:00에 영구 삭제: DB 행 + 스토리지 객체)
TRASH_RETENTION_DAYS=30

# ZIP 다운로드 한도 (총 크기 바이트 / 파일 수)
DOWNLOAD_ZIP_MAX_BYTES=2147483648
DOWNLOAD_ZIP_MAX_FILES=5000
